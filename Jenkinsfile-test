pipeline{
	agent any

	parameters {

        choice(name: 'SOURCE_KIND', choices: ['branch', 'commit', 'tag'], description: 'Origen del código del repositorio git.') 

        string(name: 'SOURCE', defaultValue: 'master', description: 'Branch, Commit Id o Tag del código del repositorio git.')

        string(name: 'PROFILE', defaultValue: 'test', description: 'Spring Profile for deployment.')

        string(name: 'SERVER', defaultValue: 'amauta-test.lamolina.edu.pe', description: 'Server configurado en Jenkins para PublushOverSSH.')

		string(name: 'PORT', defaultValue: '443', description: 'Puerto de servidor en que se ejecuta el pipeline.')
        
    }

    environment { 
        DELFIN_TEST = credentials('delfin-test') 
    }

	tools {
		jdk 'java11'
	}

	stages {
        
        stage('Checkout'){
            steps {
                script {
                   if(SOURCE_KIND == 'branch') {
                        checkout scmGit(branches: [[name: '*/${SOURCE}']])
                    } else {
                        checkout scmGit(branches: [[name: '${SOURCE}']])
                    }
                }
            }
        }
		
        stage('Build') {
            steps {
                sh '''mvn package'''
            }
        }

		 stage('Upload') {
            steps {
                sshPublisher(
                    continueOnError: false,
                    failOnError: true,
                    publishers: [
                        sshPublisherDesc(
                            configName: params.SERVER,
                            verbose: true,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: 'target/**.jar',
                                    removePrefix: 'target/'
                                )
                            ]
                        )
                    ]
                )
            }
        }

        stage('Deploy') {
            steps {
                sshPublisher(
                    continueOnError: false,
                    failOnError: true,
                    publishers: [
                        sshPublisherDesc(
                            configName: params.SERVER,
                            verbose: true,
                            transfers: [
                                sshTransfer(
                                    execTimeout: 60000,
                                    execCommand: """
                                        fuser -n tcp -k ${PORT}
                                        
                                        export USERDB=${DELFIN_TEST_USR}
                                        export PASSWORD='${DELFIN_TEST_PSW}'

                                        nohup java -jar /lost+found/amauta.jar --spring.profiles.active=${PROFILE} > /dev/null 2>&1 &
                                        wait-for-it -h localhost -p ${PORT} -t 60
                                    """
                                )
                            ]
                        )
                    ]
                )

                script {
                    if (currentBuild.result.equals('FAILURE')) {
                        error('Error en SSH')
                    }
                }
            }
        }
		
	}

}
